[Unit]
Description=HYPE Autopilot failure notification hook for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hypebot
EnvironmentFile=-/etc/hypebot/alert.env
StateDirectory=hypebot/alerts
LogsDirectory=hypebot
ExecStart=/opt/hypebot/operations/.venv/bin/hype-autopilot-alert --component %i --classification SERVICE_FAILED --audit-log /var/log/hypebot/alerts.jsonl --state /var/lib/hypebot/alerts/state.json --cooldown-seconds 900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/log/hypebot /var/lib/hypebot/alerts
