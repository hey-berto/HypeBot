[Unit]
Description=Separate-host prospective HYPE research recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hype-recorder
Group=hype-recorder
EnvironmentFile=/etc/hype-recorder/recorder.env
WorkingDirectory=/opt/hype-recorder
ExecStart=/opt/hype-recorder/venv/bin/python -m hype_recorder_service
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hype-recorder

[Install]
WantedBy=multi-user.target
