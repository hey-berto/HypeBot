[Unit]
Description=HYPE Autopilot Phase 2 epoch003 external single-writer supervisor (review template)
After=network-online.target time-sync.target hypebot-phase1.service
Wants=network-online.target time-sync.target
Requires=hypebot-phase1.service
OnFailure=hypebot-alert@%n.service
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=hypebot
Group=hypebot
SupplementaryGroups=hypebot-phase2-auth
WorkingDirectory=/opt/hypebot/phase2
EnvironmentFile=/etc/hypebot/phase2.env
UMask=0027
ExecStartPre=/opt/hypebot/phase2/.venv/bin/python /opt/hypebot/operations/deploy/operations/phase2_epoch003_start_gate.py --repo /opt/hypebot/phase2 --expected-commit 4f38eb3d8d05765ab17b42bf054f6106c4ef6c52 --expected-branch DETACHED --config config/phase2/phase2_epoch_003.yaml --expected-config-hash 7afcddf8e939d742376d9823117f6652ad6dffe20bb6a66cd4979d84c0d7d955 --expected-prompt-hash c556b5d5f9ca7b9e4c6b7aaa11b40af137c7f98c22a20a2804db6373872e5f78 --expected-schema-hash 97318c27b3765780916efe010c3653fa8f8b097bdddd20ef711d40f41a5a1be4 --expected-db-schema-hash 2ed4cb44c89833a06e3624103cac413723fcf2f1f234e57bac749adca3c9e129 --expected-epoch phase2_epoch_003 --expected-model gpt-5.6-terra --expected-reasoning medium --database /var/lib/hypebot/phase2/phase2_epoch_003.sqlite3 --grant /etc/hypebot/authorized/phase2-epoch-003.grant.json --expected-grant-group hypebot-phase2-auth
ExecStart=/opt/hypebot/phase2/.venv/bin/hype-autopilot-phase2-supervisor --worker-executable /opt/hypebot/operations/deploy/operations/phase2_epoch003_runtime_worker.py --workspace /opt/hypebot/phase2 --config config/phase2/phase2_epoch_003.yaml --epoch-id phase2_epoch_003 --expected-commit 4f38eb3d8d05765ab17b42bf054f6106c4ef6c52 --database /var/lib/hypebot/phase2/phase2_epoch_003.sqlite3 --data-root /var/lib/hypebot/phase2 --worker-lease /run/lock/hypebot/phase2.writer.lock --supervisor-lease /run/lock/hypebot/phase2.supervisor.lock --grant /etc/hypebot/authorized/phase2-epoch-003.grant.json --grant-group hypebot-phase2-auth --event-log /var/log/hypebot/phase2-supervisor.jsonl --stdout-log /var/log/hypebot/phase2.stdout.log --stderr-log /var/log/hypebot/phase2.stderr.log
Restart=on-failure
RestartSec=15s
TimeoutStopSec=45
KillMode=control-group
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/hypebot/phase2 /var/log/hypebot /run/lock/hypebot

[Install]
WantedBy=multi-user.target
