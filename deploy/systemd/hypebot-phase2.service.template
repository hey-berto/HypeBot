[Unit]
Description=HYPE Autopilot Phase 2 external single-writer supervisor (review template)
After=network-online.target time-sync.target hypebot-phase1.service
Wants=network-online.target time-sync.target
Requires=hypebot-phase1.service
ConditionPathExists=/etc/hypebot/authorized/phase2-epoch-002.grant.json
OnFailure=hypebot-alert@%n.service

[Service]
Type=simple
User=hypebot
Group=hypebot
WorkingDirectory=/opt/hypebot/phase2
EnvironmentFile=/etc/hypebot/phase2.env
UMask=0027
ExecStartPre=/opt/hypebot/phase2/.venv/bin/hype-autopilot-tooling runtime-identity --repo /opt/hypebot/phase2 --expected-commit __PHASE2_INTEGRATION_REVIEW_COMMIT__ --config config/phase2/phase2_epoch_002.yaml --database /var/lib/hypebot/phase2/phase2_epoch_002.sqlite3
ExecStart=/opt/hypebot/phase2/.venv/bin/hype-autopilot-phase2-supervisor --worker-executable /opt/hypebot/phase2/.venv/bin/hype-autopilot-phase2-worker --workspace /opt/hypebot/phase2 --config config/phase2/phase2_epoch_002.yaml --epoch-id phase2_epoch_002 --expected-commit __PHASE2_INTEGRATION_REVIEW_COMMIT__ --database /var/lib/hypebot/phase2/phase2_epoch_002.sqlite3 --data-root /var/lib/hypebot/phase2 --worker-lease /run/lock/hypebot/phase2.writer.lock --supervisor-lease /run/lock/hypebot/phase2.supervisor.lock --grant /etc/hypebot/authorized/phase2-epoch-002.grant.json --event-log /var/log/hypebot/phase2-supervisor.jsonl --stdout-log /var/log/hypebot/phase2.stdout.log --stderr-log /var/log/hypebot/phase2.stderr.log
Restart=on-failure
RestartSec=15s
StartLimitIntervalSec=900
StartLimitBurst=5
TimeoutStopSec=45
KillMode=control-group
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/hypebot/phase2 /var/log/hypebot /run/lock/hypebot

[Install]
WantedBy=multi-user.target
