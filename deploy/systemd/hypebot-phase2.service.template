[Unit]
Description=HYPE Autopilot Phase 2 epoch006 external single-writer supervisor (review template)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
OnFailure=hypebot-alert@%n.service
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=hypebot
Group=hypebot
SupplementaryGroups=hypebot-phase2-auth
WorkingDirectory=/opt/hypebot/phase2
EnvironmentFile=/etc/hypebot/phase2.env
UMask=0027
ExecStartPre=/opt/hypebot/phase2/.venv/bin/python /opt/hypebot/operations/deploy/operations/phase2_epoch006_start_gate.py --repo /opt/hypebot/phase2 --expected-commit 41e9e9acc261fd69d32c2d811e9ab4dd556c4620 --expected-branch DETACHED --config config/phase2/phase2_epoch_006.yaml --expected-config-hash c69cf18d642aec9bd6bbaa2c85d3a571f45550be7c8a252221708af403a7f24c --expected-prompt-hash c556b5d5f9ca7b9e4c6b7aaa11b40af137c7f98c22a20a2804db6373872e5f78 --expected-schema-hash 97318c27b3765780916efe010c3653fa8f8b097bdddd20ef711d40f41a5a1be4 --expected-db-schema-hash 62b5f58020cbaf19338fbfcf8e81c6b4a8f66cc67b635d2fe622e8f6d286586a --expected-epoch phase2_epoch_006 --expected-model gpt-5.6-terra --expected-reasoning medium --database /var/lib/hypebot/phase2/phase2_epoch_006.sqlite3 --grant /etc/hypebot/authorized/phase2-epoch-006.grant.json --expected-grant-group hypebot-phase2-auth
ExecStart=/opt/hypebot/phase2/.venv/bin/hype-autopilot-phase2-supervisor --worker-executable /opt/hypebot/operations/deploy/operations/phase2_epoch006_runtime_worker.py --workspace /opt/hypebot/phase2 --config config/phase2/phase2_epoch_006.yaml --epoch-id phase2_epoch_006 --expected-commit 41e9e9acc261fd69d32c2d811e9ab4dd556c4620 --database /var/lib/hypebot/phase2/phase2_epoch_006.sqlite3 --data-root /var/lib/hypebot/phase2 --worker-lease /run/lock/hypebot/phase2.writer.lock --supervisor-lease /run/lock/hypebot/phase2.supervisor.lock --grant /etc/hypebot/authorized/phase2-epoch-006.grant.json --grant-group hypebot-phase2-auth --event-log /var/log/hypebot/phase2-supervisor.jsonl --stdout-log /var/log/hypebot/phase2.stdout.log --stderr-log /var/log/hypebot/phase2.stderr.log
Restart=on-failure
RestartSec=15s
TimeoutStopSec=45
KillMode=control-group
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/hypebot/phase2 /var/log/hypebot /run/lock/hypebot

[Install]
WantedBy=multi-user.target
