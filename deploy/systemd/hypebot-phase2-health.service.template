[Unit]
Description=HYPE Autopilot Phase 2 sanitized operational health check
After=hypebot-phase2.service
OnFailure=hypebot-alert@%n.service
ConditionPathExists=/etc/hypebot/authorized/phase2-epoch-003.grant.json

[Service]
Type=oneshot
User=hypebot
Group=hypebot
WorkingDirectory=/opt/hypebot/phase2
ExecStartPre=/opt/hypebot/phase2/.venv/bin/python /opt/hypebot/operations/deploy/operations/phase2_epoch003_start_gate.py --network-only
ExecStart=/opt/hypebot/phase2/.venv/bin/hype-autopilot-tooling phase2-health --database /var/lib/hypebot/phase2/phase2_epoch_003.sqlite3 --worker-lease /run/lock/hypebot/phase2.writer.lock --supervisor-lease /run/lock/hypebot/phase2.supervisor.lock --maximum-boundary-age-minutes 20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/hypebot/phase2
ReadWritePaths=/run/lock/hypebot
